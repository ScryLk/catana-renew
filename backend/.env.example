# ==============================================================================
# CATANA BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env no mesmo diretório (nunca versione o .env real).
# 2. Gere uma SECRET_KEY criptograficamente segura:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Defina DEBUG=False para ambientes de produção.
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-me-to-a-cryptographically-secure-key-at-least-50-characters
DEBUG=False
ENVIRONMENT=production

# Database Configuration
# Para SQLite (padrão em contêiner ou local):
DATABASE_URL=sqlite:////app/db.sqlite3
# Para PostgreSQL:
# DATABASE_URL=psql://db_user:db_password@db_host:5432/db_name

# Hosts e Domínios Permitidos (separados por vírgula)
ALLOWED_HOSTS=usecatana.com.br,www.usecatana.com.br,179.236.238.62,localhost,127.0.0.1

# CORS e CSRF (separados por vírgula)
CORS_ALLOWED_ORIGINS=https://usecatana.com.br,https://www.usecatana.com.br
CSRF_TRUSTED_ORIGINS=https://usecatana.com.br,https://www.usecatana.com.br

# URLs da Aplicação Frontend
FRONTEND_URL=https://usecatana.com.br
KATANA_FRONTEND_URL=https://usecatana.com.br

# Segurança SSL/Cookies (ajuste conforme terminação TLS)
# Deixe SECURE_SSL_REDIRECT=False se o Nginx/Reverse-Proxy já redirecionar HTTP -> HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Rate Limiting / Defesa Contra Abuso
THROTTLE_ANON_RATE=300/min
THROTTLE_USER_RATE=1200/min
THROTTLE_AUTH_LOGIN_RATE=10/min
THROTTLE_AUTH_REGISTER_RATE=10/min
THROTTLE_PASSWORD_RESET_RATE=5/min

# Google Gemini AI (Catana Studio Multi-Agentes)
GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-flash-latest

# Explicit authority matching the frontend build: clerk or legacy.
AUTH_PROVIDER=clerk

# Legacy mode only: optional standalone Google OAuth credentials.
# Clerk mode never requires these; configure Google in the Clerk dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_MOCK_OAUTH=False

# Clerk mode: HTTPS JWKS URL required. api.clerk.com JWKS also requires the
# Clerk secret; a public instance-specific JWKS URL needs no secret.
# Clerk Google sign-in requires no Catana-side Google client secret.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# AbacatePay Gateway (Assinaturas e Pagamentos)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# E-mail (Password Reset & Notificações)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Catana <noreply@usecatana.com.br>

# Documento original e prévias privadas; não expor pelo Nginx /media/.
DOCUMENT_IMPORT_PRIVATE_ROOT=/app/private_document_imports
