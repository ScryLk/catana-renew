# ==============================================================================
# CATANA FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.production ou .env.local (nunca versione credenciais reais).
# 2. Em produção, configure VITE_API_BASE_URL ou deixe vazio se o Nginx rotear /api/ diretamente.
# ==============================================================================

# Backend API Endpoint
# Para desenvolvimento local: http://localhost:8000
# Para produção: https://usecatana.com.br
VITE_API_BASE_URL=https://usecatana.com.br

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# Clerk Authentication (Publishable Key)
VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Login Automático de Desenvolvimento (Sempre 'false' em produção)
VITE_AUTO_LOGIN=false

# PDF Export (Opcional - PDFShift API para geração remota de PDFs de alta fidelidade)
# VITE_PDFSHIFT_API_KEY=
