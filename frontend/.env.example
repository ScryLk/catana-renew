# ==============================================================================
# CATANA FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.production ou .env.local (nunca versione credenciais reais).
# 2. Em produção, configure VITE_API_BASE_URL ou deixe vazio se o Nginx rotear /api/ diretamente.
# ==============================================================================

# Backend API Endpoint
# Para desenvolvimento local: http://localhost:8000
# Para produção: https://usecatana.com.br
VITE_API_BASE_URL=https://usecatana.com.br

# Explicit authority for every sign-in method. Clerk owns Google/password/sign-up
# when selected. Existing Google variables never enable a second authority.
VITE_AUTH_PROVIDER=clerk

# Legacy mode only: standalone Google Identity Services client ID. Optional for
# password-only legacy mode; not required or used by Clerk Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Clerk mode: required build-time publishable key. Google is enabled/configured
# in the Clerk dashboard; no standalone Google client ID is required here.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional supported alias when VITE_CLERK_PUBLISHABLE_KEY is empty.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Login Automático de Desenvolvimento (Sempre 'false' em produção)
VITE_AUTO_LOGIN=false

# PDF Export (Opcional - PDFShift API para geração remota de PDFs de alta fidelidade)
# VITE_PDFSHIFT_API_KEY=
